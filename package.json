{
  "name": "asset-management",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "db:generate": "npm run db:generate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend",
    "start": "npm run start -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.8"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
