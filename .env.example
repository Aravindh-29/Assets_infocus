# Docker Compose settings. Choose distinct strong secrets before starting.
NODE_ENV=development
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=asset_management
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
WEB_PORT=8080
APP_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
# Optional password-recovery delivery:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=assets@example.com
